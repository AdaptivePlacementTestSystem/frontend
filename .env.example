# Sao chép thành .env.local (file này KHÔNG chứa bí mật; .env.local bị git bỏ qua)
# URL gốc của Backend NestJS (kèm prefix api/v1). Chỉ dùng phía server (proxy BFF).
API_BASE_URL=http://localhost:3001/api/v1
# Tên hiển thị (công khai)
NEXT_PUBLIC_APP_NAME=Adaptive Placement Test

# Độ dài mật khẩu tối thiểu (BR-06, Q-4 còn mở: đề xuất 8). Công khai, dùng kiểm tra ở form.
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=8

# Chỉ để phát triển/test giao diện khi chưa có Backend: 1 = dùng backend giả (dữ liệu mẫu). KHÔNG đặt ở môi trường thật.
# MOCK_API=1
